{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/client"
            ],
            "outFiles": [
                "${workspaceFolder}/client/dist/**/*.js"
            ]
        },
        {
            "name": "Attach to Server",
            "type": "node",
            "request": "attach",
            "port": 6009,
            "restart": true,
            "outFiles": [
                "${workspaceFolder}/server/dist/**/*.js"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Client + Server",
            "configurations": [
                "Launch Extension",
                "Attach to Server"
            ]
        }
    ]
}